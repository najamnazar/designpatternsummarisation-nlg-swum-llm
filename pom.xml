<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                      http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.example</groupId>
    <artifactId>code-summarisation</artifactId>
    <version>1.0.0</version>
    <properties>
        <maven.compiler.target>11</maven.compiler.target>
        <maven.compiler.source>11</maven.compiler.source>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-symbol-solver-core</artifactId>
            <version>3.26.2</version>
        </dependency>
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-core</artifactId>
            <version>3.26.2</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.16.0</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>2.16.0</version>
        </dependency>
        <dependency>
            <groupId>uk.ac.abdn</groupId>
            <artifactId>SimpleNLG</artifactId>
            <version>4.5.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>4.4</version>
        </dependency>
        <!-- CHANGE: unit tests for the shared utilities (src/test/java); run with `mvn test` -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    
    <build>
        <!-- Shared prompts live in the root-level resources/ folder so Python scripts can read them too -->
        <resources>
            <resource>
                <directory>resources</directory>
            </resource>
        </resources>
        <plugins>
            <!-- CHANGE: Surefire 3.x is needed to discover JUnit 5 tests (Maven's default 2.12 does not) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>dps_swum.swum.SWUMEvaluationPipeline</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <id>nlg</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_nlg.Application</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>swum</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_swum.swum.SWUMEvaluationPipeline</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-summaries</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                        </configuration>
                    </execution>
                    <!-- CHANGE: the LLM pipeline needs a model flag; these run it with GPT_MODEL or MISTRAL_MODEL from .env -->
                    <execution>
                        <id>llm-gpt</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--gpt</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-mistral</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--mistral</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- CHANGE: same two models with the non-concise 50-word prompt (writes llm_summaries_nonconcise_<model>.csv) -->
                    <execution>
                        <id>llm-gpt-nonconcise</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--gpt</argument>
                                <argument>--nonconcise</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-mistral-nonconcise</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--mistral</argument>
                                <argument>--nonconcise</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- CHANGE: resume a run that stopped part-way; keeps the rows already in the CSV and only requests the missing classes -->
                    <execution>
                        <id>llm-gpt-resume</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--gpt</argument>
                                <argument>--resume</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-mistral-resume</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--mistral</argument>
                                <argument>--resume</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-gpt-nonconcise-resume</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--gpt</argument>
                                <argument>--nonconcise</argument>
                                <argument>--resume</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-mistral-nonconcise-resume</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--mistral</argument>
                                <argument>--nonconcise</argument>
                                <argument>--resume</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- CHANGE: 20/40/60/80-word summaries; each sets llm.prompt.aliases to the matching prompts.json alias
                         (SENIOR_ANALYST_<n>_WORDS) and writes llm_summaries_<model>_<n>.csv, e.g. llm_summaries_gpt_20.csv.
                         The -resume ids keep the rows already in that CSV and only request the missing classes. -->
                    <execution>
                        <id>llm-gpt-20</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--gpt</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>llm.prompt.aliases</key>
                                    <value>SENIOR_ANALYST_20_WORDS</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-gpt-20-resume</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--gpt</argument>
                                <argument>--resume</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>llm.prompt.aliases</key>
                                    <value>SENIOR_ANALYST_20_WORDS</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-gpt-40</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--gpt</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>llm.prompt.aliases</key>
                                    <value>SENIOR_ANALYST_40_WORDS</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-gpt-40-resume</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--gpt</argument>
                                <argument>--resume</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>llm.prompt.aliases</key>
                                    <value>SENIOR_ANALYST_40_WORDS</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-gpt-60</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--gpt</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>llm.prompt.aliases</key>
                                    <value>SENIOR_ANALYST_60_WORDS</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-gpt-60-resume</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--gpt</argument>
                                <argument>--resume</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>llm.prompt.aliases</key>
                                    <value>SENIOR_ANALYST_60_WORDS</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-gpt-80</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--gpt</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>llm.prompt.aliases</key>
                                    <value>SENIOR_ANALYST_80_WORDS</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-gpt-80-resume</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--gpt</argument>
                                <argument>--resume</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>llm.prompt.aliases</key>
                                    <value>SENIOR_ANALYST_80_WORDS</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-mistral-20</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--mistral</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>llm.prompt.aliases</key>
                                    <value>SENIOR_ANALYST_20_WORDS</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-mistral-20-resume</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--mistral</argument>
                                <argument>--resume</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>llm.prompt.aliases</key>
                                    <value>SENIOR_ANALYST_20_WORDS</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-mistral-40</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--mistral</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>llm.prompt.aliases</key>
                                    <value>SENIOR_ANALYST_40_WORDS</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-mistral-40-resume</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--mistral</argument>
                                <argument>--resume</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>llm.prompt.aliases</key>
                                    <value>SENIOR_ANALYST_40_WORDS</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-mistral-60</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--mistral</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>llm.prompt.aliases</key>
                                    <value>SENIOR_ANALYST_60_WORDS</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-mistral-60-resume</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--mistral</argument>
                                <argument>--resume</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>llm.prompt.aliases</key>
                                    <value>SENIOR_ANALYST_60_WORDS</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-mistral-80</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--mistral</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>llm.prompt.aliases</key>
                                    <value>SENIOR_ANALYST_80_WORDS</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>llm-mistral-80-resume</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.DpsLlmApplication</mainClass>
                            <arguments>
                                <argument>--mistral</argument>
                                <argument>--resume</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>llm.prompt.aliases</key>
                                    <value>SENIOR_ANALYST_80_WORDS</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>prompt-demo</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>dps_llm.prompt.PromptConfigurationExample</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
