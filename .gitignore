# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

*target

# Maven build directory
/target/

# For multi-module projects
**/target/

# IDE files
*.iml
.idea/
.classpath
.project
.settings/
.vscode/

# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python virtual environments
.venv/
venv/
env/
ENV/

# Generic compiled/binary artifacts
*.o
*.obj
*.a
*.lib
*.dll
*.dylib
*.exe
*.out

# Common build output directories
build/
dist/
out/
bin/

# Environment and secret files
.env
.env.*
!.env.example

# Nested Git metadata copied from external repos
**/.git/
**/.git
**/.gitmodules

# ---- Personal work / scratch areas ----
archive/
scratch/
tmp/
notes/
*.local.*

# ---- Intermediate / backup versions of results ----
*_before_*.csv          # e.g. four_way_ranking_detail_before_rescore.csv
*_backup*
*_old.*
*.bak
*.orig

# ---- Console dumps and raw LLM responses (can be regenerated) ----
*_console_output.txt    # e.g. ranking_console_output.txt
*_raw.jsonl             # fact_preservation_raw.jsonl is ~1.1 MB of raw judge output

# ---- Office lock files (you have .xlsx annotation files) ----
~$*

# ---- OS and editor junk ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# ---- Jupyter / test coverage ----
.ipynb_checkpoints/
.coverage
htmlcov/

# ---- Local Claude Code / AI tool settings ----
.claude/settings.local.json
CLAUDE.local.md
